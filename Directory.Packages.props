<Project>

  <!-- ===========================================================================
       Central package version management.

       Every package version for the solution is declared here once, and the
       .csproj files reference packages without a Version attribute. Before this
       file existed the versions were spread across five project files, which is
       how the EF Core dependency arrived as a package downgrade: EF Core 10.0.14
       pulls Microsoft.Extensions.* 10.0.14, while the projects pinned 10.0.12.

       Keep the Microsoft.Extensions.* and EF Core versions in step with each
       other, and with the SDK band in global.json.
       =========================================================================== -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- A PackageReference that forgets to drop its Version attribute is a build
         error rather than a silent override of this file. -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft.Extensions and ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Reporting artefacts">
    <!-- MIT. Chosen over QuestPDF, whose Community licence requires annual gross revenue under
         USD 1,000,000, and over PDFsharp 6.x, which is AGPL-3.0-only and therefore unsuitable
         for an application served over a network. -->
    <PackageVersion Include="PdfSharpCore" Version="1.3.67" />

    <!-- Pinned above the 1.0.4 that PdfSharpCore depends on, which carries three high and five
         moderate severity advisories (GHSA-2cmq-823j-5qj8, GHSA-63p8-c4ww-9cg7,
         GHSA-65x7-c272-7g7r and others) and failed the CI build under -warnaserror.

         2.1.11 rather than 3.x deliberately: ImageSharp 3 moved to the Six Labors Split
         License, which requires a commercial licence above a revenue threshold — the same trap
         avoided by choosing PdfSharpCore over QuestPDF. The 2.1.x line stays Apache-2.0. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Advertising">
    <PackageVersion Include="Microsoft.BingAds.SDK" Version="13.0.30" />
  </ItemGroup>

  <ItemGroup Label="AI providers (optional commentary)">
    <PackageVersion Include="Anthropic" Version="12.55.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
