<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MsAds.Auditor.Core\MsAds.Auditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT. See Directory.Packages.props for why this rather than QuestPDF or PDFsharp 6. -->
    <PackageReference Include="PdfSharpCore" />

    <!-- Referenced directly only to lift PdfSharpCore's vulnerable transitive dependency to a
         patched, Apache-2.0 version. Nothing here calls ImageSharp: these documents draw no
         images, so the vulnerable decoders were never reachable — but an unpatched high-severity
         advisory in the dependency graph is not something to leave sitting there. -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- ============================================================================
         ImageSharp advisory suppressions, with the reasoning, because a suppression
         without one is indistinguishable from carelessness.

         Every one of these is in an ImageSharp image DECODER, and is exploited by
         feeding it a malformed image. This project renders text, rules and filled
         rectangles: it calls no image API at all — no XImage, no DrawImage, nothing
         that opens a file or a stream as an image. ImageSharp is present only
         because PdfSharpCore declares a dependency on it. The vulnerable code is
         therefore unreachable from this application.

         2.1.11 is the last Apache-2.0 release and already the highest 2.x. The
         fixes are in ImageSharp 3.x, which moved to the Six Labors Split License
         and requires a paid licence above a revenue threshold — the same trap that
         ruled out QuestPDF. Taking the fix would mean taking that licence.

         ImageSharpIsUnreachableTests asserts no image API appears in this project,
         so if a logo is ever added to a report this justification stops being true
         and the test fails rather than the suppression quietly covering it.

         Revisit if: an image is added to any artefact, ImageSharp publishes a
         patched Apache-2.0 2.x, or PdfSharpCore drops the dependency.
         ============================================================================ -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests exercise the layout measurement and the font discovery directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MsAds.Auditor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
