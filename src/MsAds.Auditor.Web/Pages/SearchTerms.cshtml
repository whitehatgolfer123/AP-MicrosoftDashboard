@page
@model SearchTermsModel
@{
    ViewData["Title"] = "Search Term Waste";
    var report = Model.Report;
}

@if (report is null)
{
    @await Html.PartialAsync("_NoReport", Model.ReportExpired)
}
else
{
    var analysis = report.SearchTerms;
    var formatter = report.Formatter;
    var settings = report.Settings;

    @if (!report.Selection.SearchTerms)
    {
        <div class="notice notice--info" role="note">
            <span class="notice__icon" aria-hidden="true">ℹ</span>
            <div class="notice__body">
                <span class="notice__title">Search term analysis was not selected</span>
                This report was generated without the search term analysis, so no search query report was
                requested. Generate a new report with "Search term waste" selected to see this section.
            </div>
        </div>
    }
    else if (analysis.DataUnavailable)
    {
        <div class="notice notice--error" role="alert">
            <span class="notice__icon" aria-hidden="true">⛔</span>
            <div class="notice__body">
                <span class="notice__title">Search term data could not be retrieved</span>
                The search query report was not available for this period. <strong>This is not evidence that
                no wasted spend exists</strong> — it means the analysis could not run. Try generating the
                report again.
            </div>
        </div>
    }

    <div class="notice notice--warning" role="note">
        <span class="notice__icon" aria-hidden="true">⚠</span>
        <div class="notice__body">
            <span class="notice__title">What this table can and cannot tell you</span>
            Microsoft Advertising does not publish every search query: low-volume queries and those withheld
            for user-privacy reasons are excluded. The spend shown here is therefore a <strong>subset</strong>
            of total spend, and the absence of a wasteful term is never proof that none exists.
        </div>
    </div>

    <div class="tiles">
        <div class="tile">
            <span class="tile__label">Terms reported</span>
            <span class="tile__value">@analysis.TermCount</span>
            <span class="tile__previous">queries published for this period</span>
        </div>
        <div class="tile">
            <span class="tile__label">Spend covered</span>
            <span class="tile__value">@formatter.FormatCurrency(analysis.SpendAnalysed)</span>
            <span class="tile__previous">of @formatter.FormatCurrency(report.Current.Spend) total account spend</span>
        </div>
        <div class="tile">
            <span class="tile__label">Terms flagged</span>
            <span class="tile__value">@analysis.FlaggedCount</span>
            <span class="tile__previous">@formatter.FormatCurrency(analysis.FlaggedSpend) of spend</span>
        </div>
        <div class="tile">
            <span class="tile__label">Spend with no conversions</span>
            <span class="tile__value">@formatter.FormatCurrency(analysis.UnproductiveSpend)</span>
            <span class="tile__previous">exposure, not guaranteed savings</span>
        </div>
    </div>

    <div class="card">
        <div class="card__head">
            <div>
                <h2>Search Term Opportunities</h2>
                <p class="card__note">
                    Flagged against the configured thresholds: minimum spend
                    @formatter.FormatCurrency(settings.SearchTermMinimumSpend),
                    minimum clicks @settings.SearchTermMinimumClicks@(settings.HasTargetCpa ? $", target CPA {formatter.FormatCurrency(settings.TargetCpa)}" : ", no target CPA configured").
                </p>
            </div>
            <a class="btn btn--secondary btn--small" asp-page="/Export"
               asp-route-report="@report.ReportId" asp-route-section="search-terms">
                <span aria-hidden="true">⤓</span> Export CSV
            </a>
        </div>

        <div class="card__body">
            <div class="filters" data-filters-for="term-table">
                <div class="field">
                    <label for="term-search">Search</label>
                    <input type="search" id="term-search" data-filter-field="text" placeholder="Term, campaign, ad group…" />
                </div>
                <div class="field">
                    <label for="term-action">Recommended action</label>
                    <select id="term-action" data-filter-field="action">
                        <option value="">All actions</option>
                        @foreach (var action in analysis.Assessments.Select(a => a.RecommendedAction).Distinct())
                        {
                            <option value="@action.ToString().ToLowerInvariant()">@action.Label()</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="term-campaign">Campaign</label>
                    <select id="term-campaign" data-filter-field="campaign">
                        <option value="">All campaigns</option>
                        @foreach (var campaign in analysis.Assessments.Select(a => a.Term.CampaignName).Where(c => c is not null).Distinct().OrderBy(c => c))
                        {
                            <option value="@campaign?.ToLowerInvariant()">@campaign</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="term-flagged">Show</label>
                    <select id="term-flagged" data-filter-field="flagged">
                        <option value="">All terms</option>
                        <option value="yes">Flagged only</option>
                        <option value="no">Not flagged</option>
                    </select>
                </div>
                <button type="button" class="btn btn--secondary btn--small" data-filter-reset>Reset</button>
                <span class="count-note" data-filter-count="term-table"></span>
            </div>
        </div>

        <div class="table-scroll">
            <table class="data" id="term-table" data-sortable>
                <caption class="visually-hidden">
                    Search terms for @report.DateRangeLabel with the reason each was flagged and the
                    recommended action.
                </caption>
                <thead>
                    <tr>
                        <th class="sortable col-name" aria-sort="none" scope="col"><button type="button">Search term <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable col-context" aria-sort="none" scope="col"><button type="button">Campaign / ad group <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th scope="col">Match type</th>
                        <th class="sortable num" aria-sort="none" scope="col"><button type="button">Impr. <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable num" aria-sort="none" scope="col"><button type="button">Clicks <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable num" aria-sort="none" scope="col"><button type="button">Spend <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable num" aria-sort="none" scope="col"><button type="button">Conv. <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable num" aria-sort="none" scope="col"><button type="button">Conv. rate <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable num" aria-sort="none" scope="col"><button type="button">CPA <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable col-reason" aria-sort="none" scope="col"><button type="button">Reason for flagging <span class="arrow" aria-hidden="true">⇅</span></button></th>
                        <th class="sortable col-action" aria-sort="none" scope="col"><button type="button">Recommended action <span class="arrow" aria-hidden="true">⇅</span></button></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var assessment in analysis.Assessments)
                {
                    var term = assessment.Term;
                    var metrics = term.Metrics;

                    <tr data-action="@assessment.RecommendedAction.ToString().ToLowerInvariant()"
                        data-campaign="@term.CampaignName?.ToLowerInvariant()"
                        data-flagged="@(assessment.IsFlagged ? "yes" : "no")">
                        <td class="wrap col-name">
                            <strong>@term.SearchTerm</strong>
                            @if (term.Keyword is not null)
                            {
                                <span class="sub">matched keyword: @term.Keyword</span>
                            }
                        </td>
                        <td class="wrap col-context">
                            @(term.CampaignName ?? MetricFormatter.NotAvailable)
                            <span class="sub">@(term.AdGroupName ?? "ad group not reported")</span>
                        </td>
                        <td>
                            @(term.BidMatchType ?? MetricFormatter.NotAvailable)
                            @if (term.DeliveredMatchType is not null && term.DeliveredMatchType != term.BidMatchType)
                            {
                                <span class="sub">delivered: @term.DeliveredMatchType</span>
                            }
                        </td>
                        <td class="num" data-sort="@ViewHelpers.SortValue(metrics.Impressions)">@formatter.FormatInteger(metrics.Impressions)</td>
                        <td class="num" data-sort="@ViewHelpers.SortValue(metrics.Clicks)">@formatter.FormatInteger(metrics.Clicks)</td>
                        <td class="num" data-sort="@ViewHelpers.SortValue(metrics.Spend)">@formatter.FormatCurrency(metrics.Spend)</td>
                        <td class="num" data-sort="@ViewHelpers.SortValue(metrics.Conversions)">@formatter.FormatInteger(metrics.Conversions)</td>
                        <td class="num" data-sort="@ViewHelpers.SortValue(metrics.ConversionRate)">@formatter.FormatPercent(metrics.ConversionRate)</td>
                        <td class="num" data-sort="@ViewHelpers.SortValue(metrics.CostPerAcquisition)">@formatter.FormatCurrency(metrics.CostPerAcquisition)</td>
                        <td class="wrap col-reason">
                            @assessment.Reason
                            @if (assessment.Flags.Count > 0)
                            {
                                <span class="sub">@assessment.FlagSummary</span>
                            }
                        </td>
                        <td class="wrap col-action">
                            <span class="@ViewHelpers.ActionBadgeClass(assessment.RecommendedAction)">
                                @assessment.RecommendedAction.Label()
                            </span>
                            <span class="sub">@ViewHelpers.ConfidenceLabel(assessment.Confidence)</span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (analysis.TermCount == 0)
        {
            <div class="card__body">
                <div class="empty">
                    <span class="empty__icon" aria-hidden="true">⌕</span>
                    <p>
                        @if (analysis.DataUnavailable)
                        {
                            @:The search query report could not be retrieved, so no terms could be assessed.
                        }
                        else
                        {
                            @:No search terms were reported for this period.
                        }
                    </p>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card__head">
            <div>
                <h2>Proposed negative keywords</h2>
                <p class="card__note">
                    @analysis.SuggestedNegativeKeywords.Count term(s) meet every condition: spend above
                    @formatter.FormatCurrency(settings.SearchTermMinimumSpend), at least
                    @settings.SearchTermMinimumClicks clicks, and a confirmed zero conversions.
                </p>
            </div>
            <div class="toolbar">
                <button type="button" class="btn btn--secondary btn--small" data-copy-target="negative-list">Copy list</button>
                <a class="btn btn--secondary btn--small" asp-page="/Export"
                   asp-route-report="@report.ReportId" asp-route-section="negative-keywords">
                    <span aria-hidden="true">⤓</span> Export CSV
                </a>
            </div>
        </div>
        <div class="card__body">
            <div class="notice notice--warning" role="note">
                <span class="notice__icon" aria-hidden="true">⚠</span>
                <div class="notice__body">
                    <span class="notice__title">Review before applying — nothing is applied automatically</span>
                    A negative keyword blocks all future matching of the query, so check each one against the
                    account's objectives first. No change is ever made without you selecting it and confirming
                    it on the <a asp-page="/Apply" asp-route-report="@report.ReportId">Apply Changes</a> page;
                    where applying is switched off, copy the list and add them manually.
                </div>
            </div>

            @if (analysis.SuggestedNegativeKeywords.Count == 0)
            {
                <p class="count-note">
                    No term met the full evidence bar for exclusion. Terms with insufficient data appear in the
                    table above marked "Continue monitoring" rather than being proposed here.
                </p>
            }
            else
            {
                <label class="label" for="negative-list">
                    One term per line, ready to paste into Microsoft Advertising
                </label>
                <textarea class="negatives" id="negative-list" rows="@Math.Min(analysis.SuggestedNegativeKeywords.Count + 1, 14)" readonly
                          aria-describedby="negative-list-hint">@(string.Join("\n", analysis.SuggestedNegativeKeywords))</textarea>
                <p class="count-note" id="negative-list-hint">
                    Each is listed with its campaign, spend and reason in the CSV export.
                </p>
            }
        </div>
    </div>

    @await Html.PartialAsync("_Notices", analysis.Notices)
}
