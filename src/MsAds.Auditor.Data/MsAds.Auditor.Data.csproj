<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MsAds.Auditor.Core\MsAds.Auditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />

    <!-- Binding PersistenceOptions from configuration: Bind() comes from the Options
         ConfigurationExtensions package and Get<T>() from the Configuration binder. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />

    <!-- SQLite is the default provider: free, no server to run or back up, and one file to
         copy. PostgreSQL is supported for a hosted deployment, as ROADMAP.md targets. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by `dotnet ef` to build the model at design time. It carries no runtime cost:
         the package is a development dependency and is not deployed. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The tests exercise the entity mapping and the JSON converters directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MsAds.Auditor.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
